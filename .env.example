# Copy this file to .env (same folder as pyproject.toml), paste your key, then run:
#     research-run --check
# Never commit .env: it is in .gitignore.

# --- LLM: any OpenAI-compatible endpoint ----------------------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Use a cheap, NON-reasoning chat model (reasoning models spend the token limit on
# hidden thinking and are slow). Check your provider's model list for current names.
LLM_MODEL=gpt-4o-mini

# Other providers (change all three lines):
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   Qwen:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   Ollama:    LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.1   LLM_API_KEY=ollama

# --- Judge (only used by the eval) -----------------------------------------------
# Best practice: a stronger and *different* model than LLM_MODEL. Blank = same as LLM_MODEL.
JUDGE_MODEL=
# Optional: judge on another provider (e.g. generate with DeepSeek, judge with OpenAI).
# Blank = same endpoint and key as above.
JUDGE_BASE_URL=
JUDGE_API_KEY=

# --- Search --------------------------------------------------------------------------
# duckduckgo: free, no key; fetches the full text of each result page.
# tavily: needs TAVILY_API_KEY (free tier); more stable for the 100-query eval.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
RESULTS_PER_QUERY=5
FETCH_PAGES=true
FETCH_TIMEOUT=8

# --- Concurrency & resilience -------------------------------------------------------
MAX_CONCURRENCY=4
LLM_CONCURRENCY=4
# Keep this low for DuckDuckGo: it rate-limits bursts of queries.
SEARCH_CONCURRENCY=2
MAX_RETRIES=4
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8

# --- Context budgets (tokens) ----------------------------------------------------------
SUMMARIZER_TOKEN_BUDGET=2500
PER_SOURCE_TOKEN_CAP=600
WRITER_TOKEN_BUDGET=5000

# --- Behaviour -----------------------------------------------------------------------
GROUNDED=true
PRUNE_CONTEXT=true
DROP_UNCITED=false
CHECKPOINT_DIR=.runs
